# Copy this file to .env and fill in real values. .env itself is gitignored
# and should never be committed — this file documents what's needed without
# exposing real secrets.

# Postgres connection strings.
# Local development uses a Postgres that runs on your machine: `npm run dev` starts it
# automatically (embedded-postgres, data in ./.local-db) and applies migrations. Keep
# these values for local work; then run `npm run db:seed` once for the ahmed test agent.
# Production/Preview get their own values from Vercel's Neon integration.
# DATABASE_URL is the pooled connection used at runtime; DATABASE_URL_UNPOOLED is the
# direct connection Prisma Migrate needs (locally both are the same).
# See: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/agentprofile"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5433/agentprofile"

# NextAuth session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Shared password for the /admin review panel.
ADMIN_PASSWORD=""

# Base URL used to build links in emails (password reset, email verification).
# Set this to your real domain in production — never trust the request's Host
# header for this, it can be spoofed to point reset links at another domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email delivery for password resets, email verification, and the "Book a
# Viewing" / "Send a Message" forms (lib/email.ts).
# Get a free API key at https://resend.com — without it, actions that would
# send an email still succeed, but no email goes out (the link is logged to
# the server console instead, for local development).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Vercel Blob store for agent photo uploads (app/api/upload/route.ts), authenticated
# with OIDC: no long-lived token. On Vercel the OIDC token is injected automatically;
# locally @vercel/blob fetches one through your Vercel CLI login (`vercel login` and
# `vercel link`). Get the ID from Storage → your Blob store, or `vercel env pull`.
# Must be a store with public access, since photos are rendered directly
# on public profile pages.
BLOB_STORE_ID=""

# Optional: where profile reports are emailed (needs a working Resend sender).
ADMIN_EMAIL=""
# Optional: public contact address shown on the privacy page.
CONTACT_EMAIL=""
